<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Cố ý chỉ có hai luật. Đây không phải bộ style toàn diện, mà là rào cho đúng một lỗi đã thực sự
  xảy ra: PR #81 đổi package bằng script, script thêm import cho mọi file chỉ *nhắc tên* lớp trong
  javadoc {@code ...}, và javac im lặng vì import thừa là hợp lệ trong Java.

  processJavadoc=true là điểm mấu chốt: {@link X} / @see X thực sự cần import để phân giải tên ngắn
  nên vẫn tính là "đã dùng"; còn {@code X} chỉ là văn xuôi nên không tính. Đặt false sẽ báo nhầm
  các import javadoc hợp lệ (ví dụ OrderItemEstimationService).
-->
<module name="Checker">
	<property name="severity" value="error"/>
	<property name="fileExtensions" value="java"/>

	<module name="TreeWalker">
		<module name="UnusedImports">
			<property name="processJavadoc" value="true"/>
		</module>
		<module name="RedundantImport"/>
	</module>
</module>
