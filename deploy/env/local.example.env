# Cấu hình chạy TẠI MÁY cho stack Java (`deploy/docker-compose.java.yml`).
#
# Dùng thế nào:
#
#     cp deploy/env/local.example.env deploy/.env
#     docker compose -f deploy/docker-compose.java.yml up -d --build
#
# `deploy/.env` được Compose nạp tự động (thư mục chứa tệp compose là thư mục dự án), và nó nằm
# trong `.gitignore` nên giá trị thật không bao giờ vào kho.
#
# Ba biến ở khối đầu là BẮT BUỘC — compose khai chúng dạng `${X:?...}` nên thiếu là dừng ngay với
# thông báo rõ, thay vì khởi động lên rồi hỏng ở đâu đó khó truy.

# --- bắt buộc -----------------------------------------------------------------------------------
POSTGRES_PASSWORD=doi-mat-khau-nay-di
# Tối thiểu 32 ký tự. Đây là chìa ký JWT: đặt ngắn thì token dễ bị dựng lại.
JWT_SIGNING_KEY=doi-chuoi-nay-thanh-32-ky-tu-ngau-nhien-tro-len
# Bí mật dùng chung giữa backend và dịch vụ AI. Để trống thì backend TỪ CHỐI gọi dịch vụ AI —
# trạng thái an toàn có chủ đích, không phải lỗi cấu hình.
AI_INTERNAL_TOKEN=doi-token-nay-di

# --- cổng ---------------------------------------------------------------------------------------
DEPLOY_ENV=local
COMPOSE_PROJECT_NAME=cmc-restaurant-java-local
FRONTEND_PORT=8080
BACKEND_JAVA_PORT=8081
AI_SERVICE_PORT=8001
POSTGRES_DB=restaurant_qr
POSTGRES_USER=restaurant_user

# --- URL trình duyệt gọi ------------------------------------------------------------------------
# Phải là địa chỉ nhìn từ MÁY THẬT, không phải tên dịch vụ Docker: trình duyệt của bạn không phân
# giải được `http://api:8081`.
PUBLIC_API_BASE_URL=http://127.0.0.1:8081/api
# `/hub/orders` — SỐ ÍT. Đích STOMP của Spring, không phải `/hubs/orders` của SignalR bản .NET.
PUBLIC_ORDER_HUB_URL=http://127.0.0.1:8081/hub/orders
PUBLIC_ORDERING_BASE_URL=http://127.0.0.1:8080
PUBLIC_MARKETING_BASE_URL=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- thanh toán (tuỳ chọn khi chạy local) --------------------------------------------------------
# Để trống thì mã VietQR không dựng được, nhưng luồng tiền mặt (COD) vẫn chạy đủ.
PAYMENTS_VIETQR_BANKID=
PAYMENTS_VIETQR_ACCOUNTNUMBER=
PAYMENTS_VIETQR_ACCOUNTNAME=
# Để trống thì webhook Casso từ chối MỌI lời gọi. Đúng thứ ta muốn khi chạy local.
PAYMENTS_CASSO_SECURETOKEN=

# --- dịch vụ AI ---------------------------------------------------------------------------------
# Trỏ vào một cổng không có gì lắng nghe: dịch vụ AI gọi mô hình thất bại ngay và trả lời bằng
# đường tất định. Muốn dùng mô hình thật thì điền URL và khoá của nhà cung cấp vào đây.
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=
LLM_MODEL=cx/gpt-5.6-luna-review
# Đặt 0 để tắt hẳn đường sinh và chỉ chạy khuôn mẫu tất định.
AI_ENABLE_GENERATION=1
