{
  "expo": {
    "name": "Mây",
    "slug": "restaurant-qr-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/may-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.cmc.restaurantqr"
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#F8F7F2", "foregroundImage": "./assets/may-icon.png" },
      "predictiveBackGestureEnabled": false,
      "package": "vn.cmc.restaurantqr",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mây dùng vị trí của bạn để xác định điểm nhận hàng và tính phí giao."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "may",
    "extra": {
      "eas": {
        "projectId": "cdb5956b-ac05-45ac-9065-ceeb8092d971"
      }
    },
    "owner": "anpham120"
  }
}
